---
import LandingLayout from "@layouts/LandingLayout.astro";

const title = "AIOps de solo lectura · Francesc Castell";
const description =
  "Agentes que leen CloudWatch, ticketing y monitorización, correlacionan el incidente y proponen la causa. Solo lectura, coste acotado, en tu cuenta.";

const trace = [
  { t: "03:07:12", tag: "alert", text: "api-5xx-high · eu-west-1", tone: "negative" },
  { t: "03:07:13", tag: "agent", text: "investigation started", tone: "muted" },
  { t: "03:07:14", tag: "tool", text: "cloudwatch.logs(api, 15m)", tone: "muted" },
  { t: "03:07:16", tag: "tool", text: "centreon.incidents(api)", tone: "muted" },
  { t: "03:07:17", tag: "tool", text: "jira.search(\"api 5xx\")", tone: "muted" },
  { t: "03:07:18", tag: "find", text: "deploy api@2.14.0 · 02:58", tone: "info" },
  { t: "03:07:19", tag: "cause", text: "connection pool exhausted after deploy", tone: "accent" },
  { t: "03:07:19", tag: "action", text: "none — read-only", tone: "positive" },
  { t: "03:07:20", tag: "cost", text: "0,04 €", tone: "muted" },
];

const toneClass: Record<string, string> = {
  negative: "text-[var(--color-negative)]",
  muted: "text-[var(--color-ink-5)]",
  info: "text-[var(--color-info)]",
  accent: "text-[var(--color-accent)]",
  positive: "text-[var(--color-positive)]",
};

const pillars = [
  {
    title: "Solo lectura",
    body: "Roles ReadOnly y allowlist de herramientas. Cualquier escritura falla con AccessDenied.",
  },
  {
    title: "Tus fuentes",
    body: "CloudWatch, Centreon, Grafana, Jira y tu propia documentación, como herramientas tipadas.",
  },
  {
    title: "Coste acotado",
    body: "Un techo por investigación y el coste medido en cada una. Sin sorpresas en la factura.",
  },
];

const steps = [
  {
    n: "01",
    title: "Conecto",
    body: "Tres fuentes en el piloto: las que ya usas para operar.",
  },
  {
    n: "02",
    title: "Limito",
    body: "Allowlist explícita, sin escritura, y un techo de coste por investigación.",
  },
  {
    n: "03",
    title: "Mido",
    body: "Modo sombra sobre incidentes reales. Informe de precisión, tiempo y coste.",
  },
];

const mailto =
  "mailto:hola@francastell.com?subject=AIOps&body=Hola%20Francesc%2C%0A%0ANos%20interesa%20ver%20esto.%20Nuestro%20entorno%3A%0A";
---

<LandingLayout title={title} description={description}>
  <header class="border-b border-[var(--color-border)]">
    <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-5">
      <a href="https://francastell.com" class="font-mono text-xs tracking-[0.18em] text-[var(--color-ink-3)] transition-colors hover:text-[var(--color-ink)]">
        FRANCESC CASTELL
      </a>
      <div class="flex items-center gap-5">
        <a href="https://francastell.com" class="hidden font-mono text-xs text-[var(--color-ink-4)] transition-colors hover:text-[var(--color-ink)] sm:block">
          Portfolio ↗
        </a>
        <a
          href={mailto}
          class="rounded-sm border border-[var(--color-border-strong)] bg-[var(--color-surface-2)] px-3 py-1.5 font-mono text-xs text-[var(--color-ink-2)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          Hablemos
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="relative mx-auto w-full max-w-4xl px-6 pt-20 pb-12 text-center md:pt-28">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">
          AIOps · agentes de solo lectura
        </p>
        <h1 class="mt-5 font-display text-[clamp(2.3rem,6vw,4.4rem)] font-semibold leading-[1.02] tracking-[-0.035em] text-[var(--color-ink)]">
          La guardia no necesita<br />
          más alarmas.<br />
          <span class="text-[var(--color-accent)]">Necesita un diagnóstico.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-[var(--color-ink-3)] md:text-lg">
          Agentes que leen CloudWatch, tu ticketing y tu monitorización,
          correlacionan el incidente y proponen la causa. En tu cuenta.
          Sin permisos de escritura.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href={mailto}
            class="inline-flex items-center gap-2 rounded-sm bg-[var(--color-ink)] px-5 py-3 text-sm font-semibold text-[var(--color-canvas)] transition-colors hover:bg-[var(--color-accent)]"
          >
            Hablemos
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="#como"
            class="inline-flex items-center gap-2 rounded-sm border border-[var(--color-border-strong)] bg-[var(--color-surface-2)] px-5 py-3 text-sm font-semibold text-[var(--color-ink)] transition-colors hover:border-[var(--color-accent)]"
          >
            Ver cómo funciona
          </a>
        </div>
      </div>

      <!-- TRACE -->
      <div class="relative mx-auto w-full max-w-5xl px-6 pb-20 md:pb-28">
        <div class="overflow-hidden rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface)] shadow-[var(--shadow-lg)]">
          <div class="flex items-center justify-between border-b border-[var(--color-border)] px-5 py-3">
            <div class="flex items-center gap-2">
              <span class="size-2 rounded-full bg-[var(--color-negative)]"></span>
              <span class="size-2 rounded-full bg-[var(--color-accent)]"></span>
              <span class="size-2 rounded-full bg-[var(--color-positive)]"></span>
            </div>
            <span class="font-mono text-[10px] uppercase tracking-[0.18em] text-[var(--color-ink-5)]">
              agent trace · 03:07
            </span>
          </div>
          <div class="space-y-2 px-4 py-6 font-mono text-[10px] sm:px-5 sm:text-sm">
            {
              trace.map((line, i) => (
                <div class="trace-line flex gap-3 sm:gap-4" style={`--i:${i}`}>
                  <span class="w-[4.2rem] shrink-0 text-[var(--color-ink-5)] sm:w-[4.8rem]">{line.t}</span>
                  <span class={`w-[3.2rem] shrink-0 uppercase ${toneClass[line.tone]} sm:w-[3.8rem]`}>{line.tag}</span>
                  <span class="text-[var(--color-ink-2)]">{line.text}</span>
                </div>
              ))
            }
            <div class="trace-line flex gap-3 sm:gap-4" style={`--i:${trace.length}`}>
              <span class="w-[4.2rem] shrink-0 text-[var(--color-ink-5)] sm:w-[4.8rem]">03:07:20</span>
              <span class="text-[var(--color-accent)]">▌</span>
            </div>
          </div>
          <div class="flex items-center justify-between border-t border-[var(--color-border)] px-5 py-3 font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--color-ink-5)]">
            <span>9 pasos · 8 segundos</span>
            <span>sin escribir nada</span>
          </div>
        </div>
      </div>
    </section>

    <!-- PILLARS -->
    <section class="border-t border-[var(--color-border)]">
      <div class="mx-auto grid w-full max-w-5xl gap-8 px-6 py-16 sm:grid-cols-3 md:py-20">
        {
          pillars.map((p) => (
            <div>
              <h2 class="text-base font-semibold text-[var(--color-ink)]">{p.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-3)]">{p.body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- HOW -->
    <section id="como" class="border-t border-[var(--color-border)]">
      <div class="mx-auto w-full max-w-5xl px-6 py-16 md:py-20">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-ink-5)]">Cómo funciona</p>
        <div class="mt-8 grid gap-8 sm:grid-cols-3">
          {
            steps.map((s) => (
              <div class="border-t border-[var(--color-border-strong)] pt-4">
                <div class="font-mono text-xs text-[var(--color-accent)]">{s.n}</div>
                <h2 class="mt-2 text-lg font-semibold text-[var(--color-ink)]">{s.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-3)]">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-[var(--color-border)]">
      <div class="mx-auto w-full max-w-3xl px-6 py-20 text-center md:py-28">
        <h2 class="font-display text-[clamp(2rem,4.5vw,3.2rem)] font-semibold leading-tight text-[var(--color-ink)]">
          Hablemos.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-[var(--color-ink-3)]">
          Precio según alcance. En veinte minutos te digo si esto mejora tu
          guardia o si no te sirve.
        </p>
        <a
          href={mailto}
          class="mt-8 inline-flex items-center gap-2 rounded-sm bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-[var(--color-canvas)] transition-colors hover:bg-[var(--color-accent-2)]"
        >
          hola@francastell.com
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-[var(--color-border)]">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-6 py-8 text-xs text-[var(--color-ink-5)] sm:flex-row sm:items-center sm:justify-between">
      <span class="font-mono">Francesc Castell · Barcelona</span>
      <a href="https://francastell.com" class="font-mono transition-colors hover:text-[var(--color-ink)]">
        francastell.com ↗
      </a>
    </div>
  </footer>
</LandingLayout>

<style>
  .hero-glow {
    position: absolute;
    inset: -10% 0 auto 0;
    height: 560px;
    background: radial-gradient(
      55% 55% at 50% 0%,
      color-mix(in oklab, var(--color-accent) 16%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .trace-line {
    opacity: 0;
    transform: translateY(3px);
    animation: trace-in 0.35s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--i) * 0.42s + 0.45s);
  }

  @keyframes trace-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trace-line {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>
