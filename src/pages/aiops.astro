---
import LandingLayout from "@layouts/LandingLayout.astro";

const title = "AIOps de solo lectura · Francesc Castell";
const description =
  "Agentes de solo lectura que investigan incidentes, correlacionan señales y proponen la causa. Para equipos que operan AWS, tengan guardia o no.";

const scenarios = [
  {
    label: "Incidente",
    question: "¿Qué pasó anoche en la API?",
    tag: "causa",
    result: "pool agotado tras el deploy",
    meta: "confianza 0,92 · 8s · 0,04 €",
    pill: "causa",
    status: "causa: pool agotado tras el deploy",
  },
  {
    label: "Coste",
    question: "¿Por qué subió la factura de marzo?",
    tag: "coste",
    result: "NAT Gateway y logs retenidos",
    meta: "confianza 0,88 · 11s · 0,05 €",
    pill: "coste",
    status: "coste: NAT Gateway y logs retenidos",
  },
  {
    label: "Cambio",
    question: "¿Qué toca este PR?",
    tag: "impacto",
    result: "3 servicios, 1 bucket, sin downtime",
    meta: "confianza 0,95 · 9s · 0,03 €",
    pill: "impacto",
    status: "impacto: 3 servicios y 1 bucket",
  },
  {
    label: "Dependencias",
    question: "¿Quién depende de este servicio?",
    tag: "mapa",
    result: "4 consumidores en 2 equipos",
    meta: "confianza 0,90 · 7s · 0,03 €",
    pill: "mapa",
    status: "mapa: 4 consumidores en 2 equipos",
  },
];

const memory = [
  {
    title: "Memoria semántica",
    body: "Servicios, owners, dependencias y runbooks. El contexto que hoy vive en la cabeza de dos personas.",
  },
  {
    title: "Memoria episódica",
    body: "Qué pasó en incidentes anteriores, qué se probó y qué funcionó. Sin volver a empezar de cero.",
  },
  {
    title: "Bucle de mejora",
    body: "Cada investigación alimenta evals y skills. El agente mejora con tu equipo, no en abstracto.",
  },
];

const steps = [
  {
    n: "01",
    title: "Conecto",
    body: "Tres fuentes en el piloto: las que ya usas para operar.",
  },
  {
    n: "02",
    title: "Limito",
    body: "Allowlist explícita, sin escritura, y un techo de coste por investigación.",
  },
  {
    n: "03",
    title: "Mido",
    body: "Modo sombra sobre casos reales. Informe de precisión, tiempo y coste.",
  },
];

const trust = [
  { k: "Solo lectura", v: "Roles ReadOnly y allowlist. Ninguna escritura." },
  { k: "Sin retención", v: "Tus datos no se guardan fuera de tu cuenta." },
  { k: "Región EU", v: "Inferencia en Europa por defecto." },
  { k: "Evidencia", v: "Cada respuesta cita la fuente y el paso." },
];

const faq = [
  {
    q: "¿Puede escribir o desplegar?",
    a: "No. Corre con roles de solo lectura y una allowlist de herramientas. Si una investigación sugiere un cambio, lo entrega como diff y la PR la abres tú.",
  },
  {
    q: "¿Dónde van mis datos?",
    a: "Se quedan en tu cuenta. Inferencia en región europea por defecto, sin entrenamiento con tus datos y sin retención fuera de tu entorno.",
  },
  {
    q: "¿Cuánto tarda el piloto?",
    a: "Dos semanas: la primera es conexión y límites; la segunda, casos reales y medición.",
  },
  {
    q: "¿Qué necesito para empezar?",
    a: "Una cuenta AWS, un rol de lectura y tres fuentes: logs, ticketing y monitorización.",
  },
];

const mailto =
  "mailto:hola@francastell.com?subject=AIOps&body=Hola%20Francesc%2C%0A%0ANos%20interesa%20ver%20esto.%20Nuestro%20entorno%3A%0A";
---

<LandingLayout title={title} description={description}>
  <header class="border-b border-[var(--color-border)]">
    <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-6 py-5">
      <a href="https://francastell.com" class="font-mono text-xs tracking-[0.18em] text-[var(--color-ink-3)] transition-colors hover:text-[var(--color-ink)]">
        FRANCESC CASTELL
      </a>
      <div class="flex items-center gap-5">
        <a href="https://francastell.com" class="hidden font-mono text-xs text-[var(--color-ink-4)] transition-colors hover:text-[var(--color-ink)] sm:block">
          Portfolio ↗
        </a>
        <a
          href={mailto}
          class="rounded-sm border border-[var(--color-border-strong)] bg-[var(--color-surface-2)] px-3 py-1.5 font-mono text-xs text-[var(--color-ink-2)] transition-colors hover:border-[var(--color-accent)] hover:text-[var(--color-accent)]"
        >
          Hablemos
        </a>
      </div>
    </div>
  </header>

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="relative mx-auto w-full max-w-4xl px-6 pt-20 pb-10 text-center md:pt-28">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-accent)]">
          AIOps · agentes de solo lectura
        </p>
        <h1 class="mt-5 font-display text-[clamp(2.3rem,6vw,4.4rem)] font-semibold leading-[1.02] tracking-[-0.035em] text-[var(--color-ink)]">
          Un agente que entiende<br />
          tu infraestructura.<br />
          <span class="text-[var(--color-accent)]">Y no la toca.</span>
        </h1>
        <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-[var(--color-ink-3)] md:text-lg">
          Lee logs, código, tickets y documentación. Responde con la fuente,
          propone el siguiente paso y nunca escribe. Para equipos que operan
          AWS, tengan guardia o no.
        </p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
          <a
            href={mailto}
            class="inline-flex items-center gap-2 rounded-sm bg-[var(--color-ink)] px-5 py-3 text-sm font-semibold text-[var(--color-canvas)] transition-colors hover:bg-[var(--color-accent)]"
          >
            Hablemos
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="#como"
            class="inline-flex items-center gap-2 rounded-sm border border-[var(--color-border-strong)] bg-[var(--color-surface-2)] px-5 py-3 text-sm font-semibold text-[var(--color-ink)] transition-colors hover:border-[var(--color-accent)]"
          >
            Ver cómo funciona
          </a>
        </div>
      </div>

      <!-- SIMULATION -->
      <div class="relative mx-auto w-full max-w-5xl px-6 pb-20 md:pb-28">
        <div
          id="sim"
          data-state="0"
          class="sim overflow-hidden rounded-lg border border-[var(--color-border-strong)] bg-[var(--color-surface)] shadow-[var(--shadow-lg)]"
        >
          <div class="flex items-center justify-between border-b border-[var(--color-border)] px-5 py-3">
            <div class="flex items-center gap-3 font-mono text-[10px] uppercase tracking-[0.16em] text-[var(--color-ink-5)]">
              <span class="flex items-center gap-1.5">
                <span class="size-2 rounded-full bg-[var(--color-negative)]"></span>
                <span class="size-2 rounded-full bg-[var(--color-accent)]"></span>
                <span class="size-2 rounded-full bg-[var(--color-positive)]"></span>
              </span>
              <span>03:07 · eu-west-1</span>
            </div>
            <span class="sim-pill rounded-sm border px-2 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em]" data-pill>
              14 alertas
            </span>
          </div>

          <div class="flex items-baseline gap-3 border-b border-[var(--color-border)] px-5 py-3">
            <span class="font-mono text-[9px] uppercase tracking-[0.18em] text-[var(--color-ink-5)]">pregunta</span>
            <span class="text-sm text-[var(--color-ink-2)]" data-question>{scenarios[0].question}</span>
          </div>

          <div class="scene">
            <canvas id="sim-canvas" aria-hidden="true"></canvas>
            <div class="scene-labels" aria-hidden="true">
              <span class="lbl" style="left:5%;top:7%">señales</span>
              <span class="lbl" style="left:50%;top:76%;transform:translateX(-50%)">agente</span>
              <span class="lbl" style="right:4%;top:7%">fuentes</span>
              <span class="src" style="right:3%;top:22%">CloudWatch</span>
              <span class="src" style="right:3%;top:47%">GitHub</span>
              <span class="src" style="right:3%;top:72%">Jira</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-1.5 border-t border-[var(--color-border)] px-5 py-3">
            {
              scenarios.map((s, i) => (
                <button
                  type="button"
                  data-scenario={i}
                  data-final-question={s.question}
                  data-final-tag={s.tag}
                  data-final-result={s.result}
                  data-final-meta={s.meta}
                  data-final-pill={s.pill}
                  data-final-status={s.status}
                  class:list={["sim-tab", { "is-active": i === 0 }]}
                >
                  {s.label}
                </button>
              ))
            }
          </div>

          <p class="border-t border-[var(--color-border)] px-5 py-2.5 font-mono text-[9px] uppercase tracking-[0.12em] text-[var(--color-ink-5)]">
            también: postmortems · onboarding · auditoría
          </p>

          <div class="sim-result" aria-live="polite">
            <span class="result-placeholder">esperando diagnóstico…</span>
            <span class="result-content">
              <span class="result-tag" data-tag>causa</span>
              <span class="result-text" data-result-text></span>
              <span class="result-meta" data-meta>8s · 0,04 €</span>
            </span>
          </div>

          <div class="sim-progress" aria-hidden="true"><i></i></div>

          <div class="flex items-center justify-between border-t border-[var(--color-border)] px-5 py-3">
            <span class="font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--color-ink-5)]" data-status>
              14 alertas sin correlacionar
            </span>
            <button
              type="button"
              data-replay
              class="font-mono text-[10px] uppercase tracking-[0.12em] text-[var(--color-ink-4)] transition-colors hover:text-[var(--color-accent)]"
            >
              Repetir ↺
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- MEMORY -->
    <section class="border-t border-[var(--color-border)]">
      <div class="mx-auto grid w-full max-w-5xl gap-12 px-6 py-16 md:grid-cols-[1.1fr_0.9fr] md:items-center md:py-20">
        <div>
          <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-ink-5)]">Memoria y aprendizaje</p>
          <h2 class="mt-3 font-display text-2xl md:text-3xl font-semibold leading-tight text-[var(--color-ink)]">
            No empieza de cero cada vez.
          </h2>
          <p class="mt-4 max-w-xl text-base leading-relaxed text-[var(--color-ink-3)]">
            Un agente sin memoria es un buscador caro. Guarda dos tipos de contexto
            y los usa en la siguiente investigación.
          </p>
          <ul class="mt-7 space-y-5">
            {
              memory.map((m) => (
                <li class="flex gap-3">
                  <span class="mt-1 shrink-0 text-[var(--color-accent)]">→</span>
                  <div>
                    <h3 class="text-base font-semibold text-[var(--color-ink)]">{m.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-3)]">{m.body}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="flex justify-center">
          <svg viewBox="0 0 360 360" class="loop" aria-hidden="true">
            <defs>
              <marker id="loop-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
                <path d="M 0 0 L 10 5 L 0 10 Z" fill="var(--color-accent)"></path>
              </marker>
            </defs>
            <circle cx="180" cy="180" r="120" fill="none" stroke="var(--color-border)" stroke-width="1" stroke-dasharray="3 7"></circle>
            <path d="M180 60 A120 120 0 0 1 300 180" fill="none" stroke="var(--color-accent)" stroke-opacity="0.35" stroke-width="1" marker-end="url(#loop-arrow)"></path>
            <path d="M300 180 A120 120 0 0 1 180 300" fill="none" stroke="var(--color-accent)" stroke-opacity="0.35" stroke-width="1" marker-end="url(#loop-arrow)"></path>
            <path d="M180 300 A120 120 0 0 1 60 180" fill="none" stroke="var(--color-accent)" stroke-opacity="0.35" stroke-width="1" marker-end="url(#loop-arrow)"></path>
            <path d="M60 180 A120 120 0 0 1 180 60" fill="none" stroke="var(--color-accent)" stroke-opacity="0.35" stroke-width="1" marker-end="url(#loop-arrow)"></path>
            <circle cx="180" cy="60" r="4" fill="var(--color-accent)"></circle>
            <circle cx="300" cy="180" r="4" fill="var(--color-accent)"></circle>
            <circle cx="180" cy="300" r="4" fill="var(--color-accent)"></circle>
            <circle cx="60" cy="180" r="4" fill="var(--color-accent)"></circle>
            <text x="180" y="40">investiga</text>
            <text x="300" y="164">registra</text>
            <text x="180" y="330">evalúa</text>
            <text x="60" y="164">mejora</text>
            <circle r="3" fill="var(--color-accent)" class="loop-dot">
              <animateMotion dur="9s" repeatCount="indefinite" path="M180,60 A120,120 0 1,1 179.9,60"></animateMotion>
            </circle>
          </svg>
        </div>
      </div>
    </section>

    <!-- HOW -->
    <section id="como" class="border-t border-[var(--color-border)]">
      <div class="mx-auto w-full max-w-5xl px-6 py-16 md:py-20">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-ink-5)]">Cómo funciona el piloto</p>
        <div class="mt-8 grid gap-8 sm:grid-cols-3">
          {
            steps.map((s) => (
              <div class="border-t border-[var(--color-border-strong)] pt-4">
                <div class="font-mono text-xs text-[var(--color-accent)]">{s.n}</div>
                <h2 class="mt-2 text-lg font-semibold text-[var(--color-ink)]">{s.title}</h2>
                <p class="mt-2 text-sm leading-relaxed text-[var(--color-ink-3)]">{s.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- TRUST -->
    <section class="border-t border-[var(--color-border)]">
      <div class="mx-auto grid w-full max-w-5xl gap-6 px-6 py-12 sm:grid-cols-2 lg:grid-cols-4">
        {
          trust.map((t) => (
            <div>
              <div class="font-mono text-[9px] uppercase tracking-[0.16em] text-[var(--color-accent)]">{t.k}</div>
              <p class="mt-1 text-sm leading-relaxed text-[var(--color-ink-3)]">{t.v}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- FAQ -->
    <section class="border-t border-[var(--color-border)]">
      <div class="mx-auto w-full max-w-3xl px-6 py-16 md:py-20">
        <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-[var(--color-ink-5)]">Preguntas</p>
        <div class="mt-6 divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
          {
            faq.map((item) => (
              <details class="group py-4">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-[var(--color-ink)]">
                  {item.q}
                  <span class="text-[var(--color-accent)] transition-transform group-open:rotate-45">+</span>
                </summary>
                <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[var(--color-ink-3)]">{item.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-t border-[var(--color-border)]">
      <div class="mx-auto w-full max-w-3xl px-6 py-20 text-center md:py-28">
        <h2 class="font-display text-[clamp(2rem,4.5vw,3.2rem)] font-semibold leading-tight text-[var(--color-ink)]">
          Hablemos.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-[var(--color-ink-3)]">
          Precio según alcance. En veinte minutos te digo si esto mejora tu
          guardia o si no te sirve.
        </p>
        <a
          href={mailto}
          class="mt-8 inline-flex items-center gap-2 rounded-sm bg-[var(--color-accent)] px-6 py-3 text-sm font-semibold text-[var(--color-canvas)] transition-colors hover:bg-[var(--color-accent-2)]"
        >
          hola@francastell.com
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-[var(--color-border)]">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-2 px-6 py-8 text-xs text-[var(--color-ink-5)] sm:flex-row sm:items-center sm:justify-between">
      <span class="font-mono">Francesc Castell · Barcelona</span>
      <a href="https://francastell.com" class="font-mono transition-colors hover:text-[var(--color-ink)]">
        francastell.com ↗
      </a>
    </div>
  </footer>
</LandingLayout>

<style>
  .hero-glow {
    position: absolute;
    inset: -10% 0 auto 0;
    height: 560px;
    background: radial-gradient(
      55% 55% at 50% 0%,
      color-mix(in oklab, var(--color-accent) 16%, transparent),
      transparent 70%
    );
    pointer-events: none;
  }

  .scene {
    position: relative;
    height: 360px;
    overflow: hidden;
    background:
      radial-gradient(45% 60% at 50% 52%, rgba(240, 163, 42, 0.07), transparent 70%),
      var(--color-surface);
  }

  .scene::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 30px 30px;
    mask-image: radial-gradient(70% 70% at 50% 50%, #000 20%, transparent 100%);
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .scene {
      height: 300px;
    }
  }

  #sim-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .scene-labels {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .lbl {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-ink-5);
  }

  .src {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 10px;
    padding: 0.2rem 0.45rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface-2);
    color: var(--color-ink-4);
    transition:
      border-color 0.4s,
      color 0.4s,
      background-color 0.4s,
      box-shadow 0.4s;
  }

  .sim[data-state="2"] .src,
  .sim[data-state="3"] .src {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background: var(--color-accent-glow);
    box-shadow: 0 0 18px rgba(240, 163, 42, 0.15);
  }

  @media (max-width: 480px) {
    .src {
      font-size: 8px;
      padding: 0.15rem 0.3rem;
    }
  }

  .sim-tab {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0.3rem 0.6rem;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-ink-4);
    transition:
      border-color 0.25s,
      color 0.25s,
      background-color 0.25s;
  }

  .sim-tab:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .sim-tab.is-active {
    border-color: var(--color-accent);
    background: var(--color-accent-glow);
    color: var(--color-accent);
  }

  .sim-result {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 1.25rem 1.25rem;
    padding: 0.85rem 1rem;
    border: 1px dashed var(--color-border-strong);
    background: transparent;
    transition:
      border-color 0.4s,
      background-color 0.4s;
  }

  .result-placeholder {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-ink-5);
  }

  .result-content {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
  }

  .sim[data-state="3"] .sim-result {
    border: 1px solid var(--color-accent);
    background: var(--color-accent-glow);
    box-shadow: 0 0 30px rgba(240, 163, 42, 0.08);
  }

  .sim[data-state="3"] .result-placeholder {
    display: none;
  }

  .sim[data-state="3"] .result-content {
    display: flex;
  }

  .result-text span {
    display: inline-block;
    opacity: 0;
    transform: translateY(4px);
  }

  .sim[data-state="3"] .result-text span {
    animation: letter-in 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: calc(var(--c) * 0.012s + 0.1s);
  }

  .sim[data-state="3"] .sim-result {
    animation: result-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes letter-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes result-pop {
    from {
      transform: translateY(5px) scale(0.995);
    }
    to {
      transform: none;
    }
  }

  .result-tag {
    font-family: var(--font-mono);
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    padding: 0.1rem 0.35rem;
  }

  .result-text {
    font-size: 0.85rem;
    color: var(--color-ink);
  }

  .result-meta {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--color-ink-4);
  }

  @media (max-width: 640px) {
    .result-meta {
      margin-left: 0;
    }
  }

  .sim-progress {
    height: 2px;
    background: var(--color-border);
  }

  .sim-progress i {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-accent);
    transition: width 0.9s linear;
  }

  .sim[data-state="1"] .sim-progress i {
    width: 33%;
  }
  .sim[data-state="2"] .sim-progress i {
    width: 66%;
  }
  .sim[data-state="3"] .sim-progress i {
    width: 100%;
  }

  .sim-pill[data-tone="alert"] {
    color: var(--color-negative);
    border-color: color-mix(in oklab, var(--color-negative) 45%, transparent);
  }
  .sim-pill[data-tone="work"] {
    color: var(--color-accent);
    border-color: var(--color-border-accent);
  }
  .sim-pill[data-tone="done"] {
    color: var(--color-positive);
    border-color: color-mix(in oklab, var(--color-positive) 45%, transparent);
  }

  .loop {
    width: 100%;
    max-width: 340px;
    height: auto;
  }

  .loop text {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--color-ink-4);
    text-anchor: middle;
  }

  @media (prefers-reduced-motion: reduce) {
    .loop-dot {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sim .src,
    .sim .sim-result,
    .sim .sim-progress i {
      transition-duration: 0.01ms !important;
    }

    .result-text span {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }
</style>

<script>
  const sim = document.getElementById("sim");
  const canvas = document.getElementById("sim-canvas");
  const statusEl = sim?.querySelector("[data-status]");
  const pillEl = sim?.querySelector("[data-pill]");
  const replay = sim?.querySelector("[data-replay]");
  const questionEl = sim?.querySelector("[data-question]");
  const tagEl = sim?.querySelector("[data-tag]");
  const resultTextEl = sim?.querySelector("[data-result-text]");
  const metaEl = sim?.querySelector("[data-meta]");
  const tabs = sim ? Array.from(sim.querySelectorAll("[data-scenario]")) : [];
  const ctx = canvas?.getContext("2d");

  if (sim && canvas && ctx && statusEl && pillEl) {
    const ACCENT = "#f0a32a";
    const HOT = "#ffd08a";
    const RED = "#e5484d";

    const STATES = [
      { state: "0", status: "14 señales sin correlacionar", pill: "señales", tone: "alert", at: 0 },
      { state: "1", status: "conectando 3 fuentes", pill: "leyendo", tone: "work", at: 900 },
      { state: "2", status: "correlacionando señales", pill: "correlacionando", tone: "work", at: 2300 },
      { state: "3", status: "", pill: "", tone: "done", at: 3900 },
    ];

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
    const lerp = (a, b, t) => a + (b - a) * t;
    const rand = (a, b) => a + Math.random() * (b - a);

    let W = 0;
    let H = 0;
    let dpr = 1;
    let start = 0;
    let raf = 0;
    let running = false;
    let played = false;
    let nextSpawn = 1100;
    let pulse = 0;
    let alerts = [];
    let ambient = [];
    let packets = [];
    let rings = [];
    let timers = [];
    let finalPill = "causa";
    let finalTone = "done";
    let finalStatus = "";
    const pointer = { x: 0, y: 0, tx: 0, ty: 0, active: false };

    function size() {
      const rect = canvas.getBoundingClientRect();
      if (!rect.width || !rect.height) return false;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = rect.width;
      H = rect.height;
      canvas.width = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      return true;
    }

    const core = () => ({ x: W * 0.5, y: H * 0.52 });
    const sources = () => [
      { x: W * 0.9, y: H * 0.26 },
      { x: W * 0.9, y: H * 0.5 },
      { x: W * 0.9, y: H * 0.74 },
    ];

    function seed() {
      alerts = Array.from({ length: 30 }, () => {
        const x = W * rand(0.06, 0.32);
        const y = H * rand(0.1, 0.9);
        return {
          x,
          y,
          x0: x,
          y0: y,
          vx: 0,
          vy: 0,
          r: rand(1.1, 2.8),
          ph: rand(0, Math.PI * 2),
          sp: rand(0.5, 1.3),
          cap: 2300 + rand(0, 1500),
          red: Math.random() > 0.35,
          captured: false,
          dead: false,
        };
      });
      ambient = Array.from({ length: 38 }, () => ({
        x: rand(0, W),
        y: rand(0, H),
        r: rand(0.5, 1.4),
        a: rand(0.05, 0.2),
        vx: rand(-0.04, 0.04),
        vy: rand(-0.12, -0.04),
      }));
      packets = [];
      rings = [];
      nextSpawn = 1100;
      pulse = 0;
    }

    function control(c, s, i, t) {
      return {
        x: (c.x + s.x) / 2,
        y: (c.y + s.y) / 2 + [-24, 0, 24][i] + Math.sin(t / 1400 + i * 1.7) * 7,
      };
    }

    function bezier(p0, p1, p2, k) {
      const m = 1 - k;
      return {
        x: m * m * p0.x + 2 * m * k * p1.x + k * k * p2.x,
        y: m * m * p0.y + 2 * m * k * p1.y + k * k * p2.y,
      };
    }

    function draw(t) {
      if (!W || !H) return;
      const c = core();
      const srcs = sources();
      ctx.clearRect(0, 0, W, H);

      if (pointer.active) {
        pointer.x = lerp(pointer.x, pointer.tx, 0.08);
        pointer.y = lerp(pointer.y, pointer.ty, 0.08);
        const g = ctx.createRadialGradient(pointer.x, pointer.y, 0, pointer.x, pointer.y, 180);
        g.addColorStop(0, "rgba(240,163,42,0.10)");
        g.addColorStop(1, "rgba(240,163,42,0)");
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, W, H);
      }

      ctx.globalCompositeOperation = "lighter";

      ambient.forEach((a) => {
        a.x += a.vx;
        a.y += a.vy;
        if (a.y < -4) {
          a.y = H + 4;
          a.x = rand(0, W);
        }
        if (a.x < -4) a.x = W + 4;
        if (a.x > W + 4) a.x = -4;
        ctx.globalAlpha = a.a;
        ctx.fillStyle = "#f4f4f5";
        ctx.beginPath();
        ctx.arc(a.x, a.y, a.r, 0, Math.PI * 2);
        ctx.fill();
      });
      ctx.globalAlpha = 1;

      const bp = clamp((t - 800) / 1000, 0, 1);
      if (bp > 0) {
        srcs.forEach((s, i) => {
          const c1 = control(c, s, i, t);
          const ex = lerp(c.x, s.x, bp);
          const ey = lerp(c.y, s.y, bp);
          const cx = lerp(c.x, c1.x, bp);
          const cy = lerp(c.y, c1.y, bp);

          ctx.beginPath();
          ctx.moveTo(c.x, c.y);
          ctx.quadraticCurveTo(cx, cy, ex, ey);
          ctx.strokeStyle = "rgba(240,163,42,0.06)";
          ctx.lineWidth = 6;
          ctx.stroke();

          const grad = ctx.createLinearGradient(c.x, c.y, ex, ey);
          grad.addColorStop(0, "rgba(240,163,42,0.75)");
          grad.addColorStop(1, "rgba(240,163,42,0.10)");
          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.2;
          ctx.stroke();
        });
      }

      packets = packets.filter((p) => t - p.t0 < p.dur);
      packets.forEach((p) => {
        const s = srcs[p.s];
        const c1 = control(c, s, p.s, t);
        const k = clamp((t - p.t0) / p.dur, 0, 1);
        const pos = bezier(s, c1, c, k);
        p.trail.push(pos);
        if (p.trail.length > 5) p.trail.shift();
        p.trail.forEach((pt, idx) => {
          ctx.globalAlpha = (idx / p.trail.length) * 0.5;
          ctx.fillStyle = ACCENT;
          ctx.beginPath();
          ctx.arc(pt.x, pt.y, 1.5, 0, Math.PI * 2);
          ctx.fill();
        });
        ctx.globalAlpha = 1;
        ctx.shadowColor = ACCENT;
        ctx.shadowBlur = 18;
        ctx.fillStyle = HOT;
        ctx.beginPath();
        ctx.arc(pos.x, pos.y, 2.6, 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
      });

      alerts.forEach((a) => {
        if (a.dead) return;
        if (!a.captured && t >= a.cap) {
          a.captured = true;
          a.vx = rand(-0.6, 0.6);
          a.vy = rand(-0.6, 0.6);
        }
        if (a.captured) {
          const dx = c.x - a.x;
          const dy = c.y - a.y;
          a.vx += dx * 0.014 - dy * 0.003;
          a.vy += dy * 0.014 + dx * 0.003;
          a.vx *= 0.9;
          a.vy *= 0.9;
          a.x += a.vx;
          a.y += a.vy;
          if (Math.hypot(dx, dy) < 8) {
            a.dead = true;
            pulse = Math.min(1, pulse + 0.35);
            rings.push({ t0: t, dur: 600, max: 34 });
            return;
          }
        } else {
          a.x = a.x0 + Math.sin((t / 900) * a.sp + a.ph) * 3;
          a.y = a.y0 + Math.cos((t / 800) * a.sp + a.ph) * 3;
        }
        ctx.shadowColor = a.red ? RED : ACCENT;
        ctx.shadowBlur = 10;
        ctx.fillStyle = a.red ? RED : ACCENT;
        ctx.beginPath();
        ctx.arc(a.x, a.y, a.r * (a.captured ? 0.8 : 1), 0, Math.PI * 2);
        ctx.fill();
        ctx.shadowBlur = 0;
      });

      rings = rings.filter((r) => t - r.t0 < r.dur);
      rings.forEach((r) => {
        const p = clamp((t - r.t0) / r.dur, 0, 1);
        ctx.globalAlpha = (1 - p) * 0.5;
        ctx.strokeStyle = ACCENT;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.arc(c.x, c.y, 8 + p * r.max, 0, Math.PI * 2);
        ctx.stroke();
      });
      ctx.globalAlpha = 1;

      pulse *= 0.92;
      const halo = ctx.createRadialGradient(c.x, c.y, 0, c.x, c.y, 130);
      halo.addColorStop(0, `rgba(240,163,42,${0.18 + pulse * 0.2})`);
      halo.addColorStop(1, "rgba(240,163,42,0)");
      ctx.fillStyle = halo;
      ctx.fillRect(0, 0, W, H);

      ctx.save();
      ctx.shadowColor = ACCENT;
      ctx.shadowBlur = 36;
      ctx.strokeStyle = "rgba(240,163,42,0.22)";
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(c.x, c.y, 58, 0, Math.PI * 2);
      ctx.stroke();

      const scale = 1 + pulse * 0.25;
      ctx.strokeStyle = "rgba(240,163,42,0.30)";
      ctx.beginPath();
      ctx.arc(c.x, c.y, 42 * scale, 0, Math.PI * 2);
      ctx.stroke();

      const ang = (t / 1000) * 1.5;
      ctx.strokeStyle = ACCENT;
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.arc(c.x, c.y, 42 * scale, ang, ang + 1.4);
      ctx.stroke();

      const dot = (4.2 + Math.sin(t / 260) * 0.9) * scale;
      ctx.fillStyle = HOT;
      ctx.beginPath();
      ctx.arc(c.x, c.y, dot, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();

      if (t > 3900) {
        const p = clamp((t - 3900) / 1000, 0, 1);
        ctx.globalAlpha = (1 - p) * 0.5;
        ctx.strokeStyle = ACCENT;
        ctx.lineWidth = 1.4;
        ctx.beginPath();
        ctx.arc(c.x, c.y, 42 + p * 150, 0, Math.PI * 2);
        ctx.stroke();
        ctx.globalAlpha = 1;
      }

      const sy = (t * 0.06) % H;
      ctx.fillStyle = "rgba(240,163,42,0.035)";
      ctx.fillRect(0, sy, W, 1);

      ctx.globalCompositeOperation = "source-over";
    }

    function frame(now) {
      if (!running) return;
      const t = now - start;
      while (t > nextSpawn && nextSpawn < 3900 && packets.length < 60) {
        packets.push({ s: packets.length % 3, t0: nextSpawn, dur: 700, trail: [] });
        nextSpawn += 170;
      }
      draw(t);
      raf = requestAnimationFrame(frame);
    }

    function setResult(text) {
      if (!resultTextEl) return;
      resultTextEl.textContent = "";
      Array.from(text).forEach((ch, i) => {
        const span = document.createElement("span");
        span.style.setProperty("--c", String(i));
        span.textContent = ch === " " ? "\u00A0" : ch;
        resultTextEl.appendChild(span);
      });
    }

    function setFinal(tab) {
      finalPill = tab.dataset.finalPill || "causa";
      finalTone = "done";
      finalStatus = tab.dataset.finalStatus || "";
      if (tagEl) tagEl.textContent = tab.dataset.finalTag || "causa";
      if (metaEl) metaEl.textContent = tab.dataset.finalMeta || "";
      setResult(tab.dataset.finalResult || "");
    }

    function setState(i) {
      const s = STATES[i];
      sim.dataset.state = s.state;
      const last = i === STATES.length - 1;
      statusEl.textContent = last ? finalStatus : s.status;
      pillEl.textContent = last ? finalPill : s.pill;
      pillEl.dataset.tone = last ? finalTone : s.tone;
    }

    function play() {
      if (!size()) return;
      seed();
      timers.forEach(clearTimeout);
      timers = [];
      start = performance.now();
      running = true;
      cancelAnimationFrame(raf);
      setState(0);

      if (reduced) {
        setState(3);
        draw(6000);
        return;
      }

      STATES.slice(1).forEach((s, i) => {
        timers.push(window.setTimeout(() => setState(i + 1), s.at));
      });
      raf = requestAnimationFrame(frame);
    }

    function selectTab(i, restart = true) {
      tabs.forEach((t, j) => t.classList.toggle("is-active", j === i));
      const tab = tabs[i];
      if (!tab) return;
      if (questionEl) questionEl.textContent = tab.dataset.finalQuestion || "";
      setFinal(tab);
      if (restart) play();
    }

    tabs.forEach((tab, i) => tab.addEventListener("click", () => selectTab(i)));

    sim.addEventListener("pointermove", (e) => {
      const rect = canvas.getBoundingClientRect();
      pointer.tx = e.clientX - rect.left;
      pointer.ty = e.clientY - rect.top;
      if (!pointer.active) {
        pointer.x = pointer.tx;
        pointer.y = pointer.ty;
      }
      pointer.active = true;
    });

    sim.addEventListener("pointerleave", () => {
      pointer.active = false;
    });

    if (tabs.length) selectTab(0, false);

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting) && !played) {
          played = true;
          play();
          io.disconnect();
        }
      },
      { threshold: 0.35 }
    );

    io.observe(sim);
    replay?.addEventListener("click", play);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        running = false;
        cancelAnimationFrame(raf);
      } else if (played) {
        running = true;
        start = performance.now() - 4200;
        raf = requestAnimationFrame(frame);
      }
    });

    window.addEventListener("resize", () => {
      if (!played) return;
      if (size()) seed();
    });
  }
</script>
